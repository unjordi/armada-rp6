From: unjordi <jordi@ciencias.unam.mx>
Subject: [PATCH] power: supply: qcom_battmgr: pause firmware notifications
 during system suspend

On SM8550 the ADSP keeps pushing routine battery notifications
(BATTMGR_NOTIFICATION, NOTIF_BAT_STATUS) while the system sleeps. The
glink-smem doorbell that carries them is an IRQF_NO_SUSPEND interrupt
routed straight to the GIC, which stays powered in s2ram on this SoC
(CX never collapses), so each of them pulls the AP out of suspend
without an attributable wakeup IRQ (pm_wakeup_irq empty).

The first thing to run after such a resume is ipcc_0 -> glink-smem ->
PMIC_RTR_ADSP_APPS -> owner BATTMGR, NOTIFY, opcode 0x7, NOTIF_BAT_STATUS.

Ask the firmware to stop notifying while the system is suspended, using
the same request the downstream driver sends when the panel blanks
(BC_DISABLE_NOTIFY_REQ, 0x5, same layout as the enable request), and
re-request them once the AP has stayed awake for resume_notify_delay_ms
(default 20 s) after resume, refreshing the supplies so userspace re-reads
anything that changed in the meantime. A resume that suspends again sooner
keeps them paused. The enable request carries a power-state baseline (sent
as 0) that the firmware compares against its own power-state flag on every
event, and that comparison is not gated by the pause: re-enabling on each
short resume therefore made the next firmware event report BAT_STATUS and
wake the AP again, round after round, for as long as a userspace "dark
resume" loop (wake, update the charge LED, sleep again) kept going.

This is restricted to the SM8550 variant, where it was measured. It also
applies with a charger attached: charging is run by the firmware and does
not depend on these notifications, and a plug or unplug still reaches the
AP with notifications paused (a power-state change is reported regardless).
A failure to pause only logs a warning and never blocks suspend.

---
diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -17,6 +17,7 @@
 #include <linux/soc/qcom/pmic_glink.h>
 #include <linux/math.h>
 #include <linux/units.h>
+#include <linux/pm.h>
 
 #define BATTMGR_CHEMISTRY_LEN	4
 #define BATTMGR_STRING_LEN	128
@@ -31,6 +32,7 @@
 #define BATTMGR_BAT_STATUS		0x1
 
 #define BATTMGR_REQUEST_NOTIFICATION	0x4
+#define BATTMGR_DISABLE_NOTIFICATION	0x5
 
 #define BATTMGR_NOTIFICATION		0x7
 #define NOTIF_BAT_PROPERTY		0x30
@@ -335,6 +337,10 @@
 	struct completion ack;
 
 	bool service_up;
+	/* notifications were stopped by system suspend and must be re-requested */
+	bool notifications_quiesced;
+	/* re-requests notifications once the AP has stayed awake after a resume */
+	struct delayed_work resume_notify_work;
 
 	struct qcom_battmgr_info info;
 	struct qcom_battmgr_status status;
@@ -1453,6 +1459,7 @@
 
 	switch (opcode) {
 	case BATTMGR_REQUEST_NOTIFICATION:
+	case BATTMGR_DISABLE_NOTIFICATION:
 		battmgr->error = 0;
 		break;
 	case BATTMGR_BAT_INFO:
@@ -1760,6 +1767,7 @@
 		}
 		break;
 	case BATTMGR_REQUEST_NOTIFICATION:
+	case BATTMGR_DISABLE_NOTIFICATION:
 	case BATTMGR_CHG_CTRL_LIMIT_EN:
 		battmgr->error = 0;
 		break;
@@ -1802,6 +1810,103 @@
 		dev_err(battmgr->dev, "failed to request power notifications\n");
 }
 
+/*
+ * While the system sleeps the ADSP keeps pushing routine battery
+ * notifications (BATTMGR_NOTIFICATION / NOTIF_BAT_STATUS). On SM8550 the
+ * glink-smem doorbell is an IRQF_NO_SUSPEND interrupt routed straight to
+ * the GIC, which stays powered in s2ram, so every one of them pulls the
+ * AP out of suspend with no attributable wakeup IRQ, every few minutes.
+ * Ask the firmware to stop notifying for the duration of system sleep
+ * (the same request the downstream driver sends when the panel blanks)
+ * and re-request them once the AP has stayed awake after resume, on
+ * battery and while charging alike. A resume that suspends again sooner
+ * keeps them paused: the enable request resets the firmware's power-state
+ * baseline, so its next event would report BAT_STATUS even after the pause.
+ * Plugging a charger in while suspended still reaches the AP.
+ */
+static unsigned int resume_notify_delay_ms = 20000;
+module_param(resume_notify_delay_ms, uint, 0644);
+MODULE_PARM_DESC(resume_notify_delay_ms,
+		 "SM8550: ms the AP must stay awake after resume before battery notifications are re-requested (0 = at once)");
+
+static int qcom_battmgr_set_notifications(struct qcom_battmgr *battmgr, bool enable)
+{
+	struct qcom_battmgr_enable_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_NOTIFY),
+		.hdr.opcode = cpu_to_le32(enable ? BATTMGR_REQUEST_NOTIFICATION :
+						   BATTMGR_DISABLE_NOTIFICATION),
+	};
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_request(battmgr, &req, sizeof(req));
+	mutex_unlock(&battmgr->lock);
+
+	return ret;
+}
+
+static int qcom_battmgr_suspend(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	int ret;
+
+	if (battmgr->variant != QCOM_BATTMGR_SM8550 || !battmgr->service_up)
+		return 0;
+
+	/* resumed and suspended again before re-enabling: still paused */
+	if (cancel_delayed_work_sync(&battmgr->resume_notify_work))
+		return 0;
+
+	/* a re-enable queued by the previous resume must not land after the pause */
+	flush_work(&battmgr->enable_work);
+
+	ret = qcom_battmgr_set_notifications(battmgr, false);
+	if (ret) {
+		/* never block system suspend over this; just keep the old behaviour */
+		dev_warn(dev, "failed to pause notifications for suspend: %d\n", ret);
+		return 0;
+	}
+	battmgr->notifications_quiesced = true;
+
+	return 0;
+}
+
+static int qcom_battmgr_resume(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+
+	if (!battmgr->notifications_quiesced)
+		return 0;
+
+	/*
+	 * Re-arm notifications and let userspace re-read what changed meanwhile,
+	 * but only once the AP has stayed awake for resume_notify_delay_ms
+	 * (jiffies do not advance while suspended).
+	 */
+	schedule_delayed_work(&battmgr->resume_notify_work,
+			      msecs_to_jiffies(resume_notify_delay_ms));
+
+	return 0;
+}
+
+static void qcom_battmgr_resume_notify_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work), struct qcom_battmgr,
+						     resume_notify_work);
+
+	battmgr->notifications_quiesced = false;
+	schedule_work(&battmgr->enable_work);
+	if (battmgr->bat_psy)
+		power_supply_changed(battmgr->bat_psy);
+	if (battmgr->usb_psy)
+		power_supply_changed(battmgr->usb_psy);
+	if (battmgr->wls_psy)
+		power_supply_changed(battmgr->wls_psy);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(qcom_battmgr_pm_ops, qcom_battmgr_suspend, qcom_battmgr_resume);
+
 static void qcom_battmgr_pdr_notify(void *priv, int state)
 {
 	struct qcom_battmgr *battmgr = priv;
@@ -1843,6 +1948,7 @@
 		return -ENOMEM;
 
 	battmgr->dev = dev;
+	auxiliary_set_drvdata(adev, battmgr);
 
 	psy_cfg.drv_data = battmgr;
 	psy_cfg.fwnode = dev_fwnode(&adev->dev);
@@ -1942,6 +2048,11 @@
 	if (ret)
 		return ret;
 
+	ret = devm_delayed_work_autocancel(dev, &battmgr->resume_notify_work,
+					   qcom_battmgr_resume_notify_worker);
+	if (ret)
+		return ret;
+
 	/*
 	 * Wake the AP on a charger attach/detach (the USB/WLS notifications
 	 * handled above); the routine battery telemetry is left to the
@@ -1987,6 +2098,9 @@
 	.name = "pmic_glink_power_supply",
 	.probe = qcom_battmgr_probe,
 	.id_table = qcom_battmgr_id_table,
+	.driver = {
+		.pm = pm_sleep_ptr(&qcom_battmgr_pm_ops),
+	},
 };
 
 module_auxiliary_driver(qcom_battmgr_driver);
