power: reset: qcom-pon: set PS_HOLD shutdown type on GEN3 at power-off

On SM8550 (PMK8550, PON GEN3) mainline qcom-pon has no power-off handler,
so PS_HOLD_RST_CTL is left unset at shutdown. A cable insertion while the
device is off then powers on as SYSOK instead of CBLPWR, and the ROCKNIX
bootloader skips off-mode charging (boots to the fastboot menu).

Register a POWER_OFF_PREPARE sys_off handler, gated to qcom,pmk8350-pon,
that writes the SHUTDOWN power-off type into PS_HOLD_RST_CTL, mirroring the
downstream qpnp_pon_reset_config sequence for GEN3 (clear RESET_EN in
PS_HOLD_RST_CTL2, write type in PS_HOLD_RST_CTL, set RESET_EN).

--- a/drivers/power/reset/qcom-pon.c
+++ b/drivers/power/reset/qcom-pon.c
@@ -11,6 +11,7 @@
 #include <linux/reboot.h>
 #include <linux/reboot-mode.h>
 #include <linux/regmap.h>
+#include <linux/notifier.h>
 
 #define PON_SOFT_RB_SPARE		0x8f
 
@@ -19,6 +20,15 @@
 
 #define NO_REASON_SHIFT			0
 
+/* GEN3 (PMK8xxx) PS_HOLD reset control: type in PS_HOLD_RST_CTL (base+0x52),
+ * RESET_EN in PS_HOLD_RST_CTL2 (base+0x53). SHUTDOWN at power-off makes a
+ * later cable insertion report CBLPWR (off-mode charging) instead of SYSOK. */
+#define PON_GEN3_PS_HOLD_RST_CTL	0x52
+#define PON_GEN3_PS_HOLD_RST_CTL2	0x53
+#define PON_RESET_EN			BIT(7)
+#define PON_POWER_OFF_MASK		0xf
+#define PON_POWER_OFF_SHUTDOWN		0x4
+
 struct qcom_pon {
 	struct device *dev;
 	struct regmap *regmap;
@@ -44,6 +54,23 @@
 	return ret;
 }
 
+static int qcom_pon_power_off_prepare(struct sys_off_data *data)
+{
+	struct qcom_pon *pon = data->cb_data;
+
+	regmap_update_bits(pon->regmap,
+			   pon->baseaddr + PON_GEN3_PS_HOLD_RST_CTL2,
+			   PON_RESET_EN, 0);
+	udelay(500);
+	regmap_update_bits(pon->regmap,
+			   pon->baseaddr + PON_GEN3_PS_HOLD_RST_CTL,
+			   PON_POWER_OFF_MASK, PON_POWER_OFF_SHUTDOWN);
+	regmap_update_bits(pon->regmap,
+			   pon->baseaddr + PON_GEN3_PS_HOLD_RST_CTL2,
+			   PON_RESET_EN, PON_RESET_EN);
+	return NOTIFY_DONE;
+}
+
 static int qcom_pon_probe(struct platform_device *pdev)
 {
 	struct qcom_pon *pon;
@@ -80,6 +107,16 @@
 		}
 	}
 
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,pmk8350-pon")) {
+		error = devm_register_sys_off_handler(&pdev->dev,
+				SYS_OFF_MODE_POWER_OFF_PREPARE,
+				SYS_OFF_PRIO_DEFAULT,
+				qcom_pon_power_off_prepare, pon);
+		if (error)
+			dev_warn(&pdev->dev,
+				 "can't register power-off prepare handler\n");
+	}
+
 	platform_set_drvdata(pdev, pon);
 
 	return devm_of_platform_populate(&pdev->dev);
