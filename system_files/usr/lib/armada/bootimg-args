# ABL/header-v0 geometry, sourced by make-bootimg.sh + armada-bootimg-update so
# they can't drift (a mismatch ships an unbootable /KERNEL).
ARMADA_BOOTIMG_ARGS="--base 0x10000000 --pagesize 2048 --kernel_offset 0x00008000 --ramdisk_offset 0x06000000 --tags_offset 0x00000100 --header_version 0 --os_version 12.0.0"

# header-v0 also has extra_cmdline[1024], but the ABL may not read the overflow;
# cap at the first field until that's confirmed on-device.
ARMADA_CMDLINE_MAX=512

# BLS options line to /KERNEL cmdline, shared so build and on-device regen cannot
# drift. ostree= leads so a truncated header loses tuning kargs, not the root
# pointer; returns 1 without it, since that /KERNEL could never reach the rootfs.
armada_bootimg_cmdline() {
    local t ostree_arg="" rest="" rflags=""
    # Unquoted word splitting also globs; 'local -' scopes the noglob to here.
    local -
    set -f
    for t in $1; do
        case "${t}" in
            console=ttyS0) continue ;;
            ostree=*) ostree_arg="${t}" ;;
            rootflags=*) rflags="${rflags:+${rflags},}${t#rootflags=}" ;;
            *) rest="${rest} ${t}" ;;
        esac
    done
    [ -n "${ostree_arg}" ] || return 1
    rflags="${rflags//,space_cache=v2/}"
    [ -n "${rflags}" ] && rest="${rest} rootflags=${rflags}"
    printf '%s%s' "${ostree_arg}" "${rest}"
}

# Path-free digest of the real boot files (kernel initrd dtb...): ostree
# paths miss in-place regeneration, and deployed mtimes are epoch-zero.
armada_bootimg_content_id() {
    sha256sum "$@" | awk '{print $1}' | tr '\n' ' '
}
# Args: linux initrd options dtb_list args_file content_id.
armada_bootimg_id() {
    { printf '%s\n%s\n%s\n%s\n' "$1" "$2" "$3" "$6"; cat "$4" "$5"; } | sha256sum | cut -d' ' -f1
}

# Highest-version BLS entry under $1/loader/entries — ostree makes the
# next-boot deployment the highest version.
armada_default_bls_entry() {
    local f v
    for f in "$1"/loader/entries/*.conf; do
        [ -f "$f" ] || continue
        v=$(sed -n 's/^version //p' "$f" | head -1)
        printf '%s\t%s\n' "${v:-0}" "$f"
    done | sort -rn | head -1 | cut -f2
}

# Next-boot inputs shared by armada-bootimg-update and armada-chargerimg-update.
# Uses BOOTROOT, SYSROOT, DTB_LIST; sets entry linux initrd options kpath ipath
# dpath content_files and may repoint DTB_LIST. Arg: program name for messages.
armada_bootimg_resolve() {
    local prog=$1 t name fdtdir ostree_karg deploy_root
    # Next-boot deployment = highest-version BLS entry (ostree gives its default,
    # and the rollback target, the highest version), via the shared helper.
    entry=$(armada_default_bls_entry "${BOOTROOT}")
    [ -n "${entry:-}" ] || { echo "${prog}: no BLS entry in ${BOOTROOT}/loader/entries" >&2; return 1; }

    linux=$(sed -n 's/^linux //p'   "${entry}" | head -1)
    initrd=$(sed -n 's/^initrd //p' "${entry}" | head -1)
    fdtdir=$(sed -n 's/^fdtdir //p' "${entry}" | head -1)
    options=$(sed -n 's/^options //p' "${entry}" | head -1)

    # The deployment being baked owns its DTB set: the running list can name a .dtb
    # that build dropped. An unresolvable karg names no deployment at all, so baking
    # it would stamp an unbootable /KERNEL and suppress the rollback that recovers.
    ostree_karg=""
    for t in ${options}; do
        case "${t}" in ostree=*) ostree_karg="${t#ostree=}" ;; esac
    done
    [ -n "${ostree_karg}" ] || {
        echo "${prog}: no ostree= karg in ${entry}" >&2
        return 1
    }
    deploy_root=$(realpath -e "${SYSROOT%/}${ostree_karg}" 2>/dev/null) || {
        echo "${prog}: ${ostree_karg} does not resolve under ${SYSROOT}" >&2
        return 1
    }
    if [ -r "${deploy_root}/usr/lib/armada/supported-dtbs" ]; then
        DTB_LIST="${deploy_root}/usr/lib/armada/supported-dtbs"
    fi

    # BLS paths carry a /boot prefix (bootprefix=true); the files live on this fs.
    kpath="${BOOTROOT}${linux#/boot}"
    ipath="${BOOTROOT}${initrd#/boot}"
    dpath="${BOOTROOT}${fdtdir#/boot}"

    content_files=("${kpath}" "${ipath}")
    while read -r name; do
        [ -n "${name}" ] || continue
        content_files+=("${dpath}/qcom/${name}.dtb")
    done < "${DTB_LIST}"
}

# ROCKNIX ABL expects gzip(Image) with all supported DTBs appended; its model
# picker chooses among them at boot. Args: program name, output file; needs
# armada_bootimg_resolve first.
armada_bootimg_kernel_gz() {
    local prog=$1 out=$2 name dtb
    gzip -c "${kpath}" > "${out}" || return 1
    while read -r name; do
        [ -n "${name}" ] || continue
        dtb="${dpath}/qcom/${name}.dtb"
        [ -f "${dtb}" ] || { echo "${prog}: missing DTB ${dtb}" >&2; return 1; }
        cat "${dtb}" >> "${out}"
    done < "${DTB_LIST}"
}
