#!/bin/bash
# Show charge status on the stick RGB LEDs while the device sleeps.
# Opt-in, default OFF (Armada Control -> RGB Lighting -> "Show charge status
# while sleeping").
#
# WHAT IT ACTUALLY COVERS (read before trusting the LEDs mid-sleep):
#   * "I put it to sleep while it was ALREADY charging" -> YES. `pre` SEEDS the
#     current charge color (amber charging / green full) onto the LEDs and the
#     HTR3212 controllers hold that pattern in hardware through the sleep
#     (keep_alive, no CPU). This is the case Jordi asked for ("I leave it
#     charging overnight").
#   * "It gets plugged in WHILE ASLEEP", or "charging -> full WHILE ASLEEP":
#       - in s2idle: REFLECTED. The AP still services interrupts, so the kernel
#         trigger repaints on the power_supply_changed() edge.
#       - in DEEP suspend: NOT reflected until the next wake. The AP is powered
#         down (PSCI) and 45-armada-wake-policy deliberately DISABLES the
#         charger/battery wakeup (so the device doesn't wake in a bag), so
#         power_supply_changed() never runs mid-sleep and the armed trigger has
#         no edge to fire on -- only the pre-sleep SEED is shown. Reflecting a
#         mid-deep plug-in would require re-arming the charger wakeup that 45
#         removes on purpose = a kernel follow-up (armada QG-8 causa-b), not
#         this hook.
#
# Mechanism (suspend `pre`, when opted in):
#   1. STOP the armada-rgb daemon. Its paint loop reclaims these LEDs from any
#      kernel trigger on every render tick (backend.rs reclaim_led) -- so if we
#      only armed the trigger and left the daemon running, its next tick before
#      userspace freezes would DISARM our hand-off and the charge status would
#      never survive into sleep (armada QG-8). We take the daemon out of the way
#      first, then own the LEDs ourselves. The resume hook starts it back up.
#   2. keep_alive=1 on the HTR3212 controllers so they are NOT powered down in
#      suspend (kernel patch armada#26) and keep driving their PWM pattern with
#      no CPU -- their vdd rail is regulator-always-on.
#   3. Arm the kernel trigger "<psy>-charging-orange-full-green" on the group
#      LEDs. It repaints on each power_supply_changed() -- which fires mid-sleep
#      only in s2idle, not in deep suspend (see "WHAT IT ACTUALLY COVERS").
#   4. SEED the CURRENT charge state onto the LEDs right now (amber charging /
#      green full). Arming a power-supply LED trigger does NOT paint an initial
#      frame -- it only repaints on the next power_supply_changed() EDGE. If the
#      charger was already attached before sleep there is no such edge, so
#      without this seed the LEDs would sleep showing the user's last color,
#      not the charge status (armada QG-8 causa a). In deep suspend this seed is
#      the ONLY state shown until the next wake.
#
# On resume (`post`): disarm the trigger, clear keep_alive, and bring the daemon
# back so it repaints the user's own lighting.
#
# This never blocks or delays suspend: every step is best-effort and a no-op on
# a device without these LED nodes / the htr3212 driver (older image, desktop
# dev box) -- lighting is cosmetic, never a reason to abort sleep.
set -uo pipefail

sysfs_root=${ARMADA_SYSFS_ROOT:-/sys}
rgb_tool=${ARMADA_RGB_TOOL:-/usr/bin/armada-rgb}
rgb_service=${ARMADA_RGB_SERVICE:-armada-rgb.service}
# Marker (tmpfs, cleared on reboot) recording that WE stopped the daemon, so
# `post` only restarts one we actually stopped.
daemon_marker=${ARMADA_RGB_DAEMON_MARKER:-/run/armada/rgb-charge-daemon-stopped}
# Owned by armada-control (its RGB_CHARGE_INDICATOR_CONFIG); read directly here
# since this hook runs standalone via systemd, not through the plugin socket.
indicator_config=${ARMADA_RGB_CHARGE_INDICATOR_CONFIG:-/etc/armada/rgb-charge-indicator.conf}
# Battery power-supply name -> the LED trigger power_supply_leds.c registers for
# it. qcom_battmgr exposes the pack as "battery" (confirmed on-device: G1).
psy=${ARMADA_RGB_CHARGE_PSY:-battery}
trigger="${psy}-charging-orange-full-green"
# Multicolor group nodes for the two HTR3212 stick controllers (rgb:l1..l4 /
# rgb:r1..r4), and the keep_alive knob on each bound htr3212 controller.
indicator_leds_glob=${ARMADA_RGB_INDICATOR_LEDS:-"$sysfs_root/class/leds/rgb:l? $sysfs_root/class/leds/rgb:r?"}
keep_alive_glob=${ARMADA_RGB_KEEPALIVE:-"$sysfs_root/bus/i2c/drivers/htr3212/*/keep_alive"}

[[ "${2:-}" == suspend ]] || exit 0

# Opt-in, default OFF (matches armada-control's own fallback: an absent,
# unreadable or malformed file means disabled).
indicator_enabled() {
    local key value
    [[ -r "$indicator_config" ]] || return 1
    while IFS='=' read -r key value; do
        if [[ "$key" == "enabled" ]]; then
            [[ "$value" == "1" ]] && return 0 || return 1
        fi
    done <"$indicator_config"
    return 1
}

set_keep_alive() { # $1 = 0|1
    local f
    for f in $keep_alive_glob; do
        [[ -w "$f" ]] || continue
        echo "$1" >"$f" 2>/dev/null || true
    done
}

set_trigger() { # $1 = trigger name, or "none"
    local led
    for led in $indicator_leds_glob; do
        [[ -w "$led/trigger" ]] || continue
        echo "$1" >"$led/trigger" 2>/dev/null || true
    done
}

# Stop the daemon so it stops reclaiming the trigger; record that we did.
stop_daemon() {
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl is-active --quiet "$rgb_service" 2>/dev/null || return 0
    mkdir -p "$(dirname "$daemon_marker")" 2>/dev/null || true
    if timeout 5 systemctl stop "$rgb_service" 2>/dev/null; then
        : >"$daemon_marker" 2>/dev/null || true
    fi
}

# Bring the daemon back after resume. IDEMPOTENT and INDEPENDENT of the marker:
# even if `pre` stopped the daemon but the marker write FAILED (tmpfs full,
# race, mkdir failed), the daemon must still come back -- otherwise every
# animated effect, screen_sync included, stays dead until the next reboot
# (audit M2). The marker is only cleaned up here; whether we start vs nudge is
# decided by whether the service is actually running, not by the marker.
start_daemon() {
    rm -f "$daemon_marker" 2>/dev/null || true
    command -v systemctl >/dev/null 2>&1 || return 0
    if systemctl is-active --quiet "$rgb_service" 2>/dev/null; then
        # Still running (we never stopped it -- e.g. indicator off): just nudge
        # a repaint of the user's own lighting, don't restart.
        [[ -x "$rgb_tool" ]] && timeout 5 "$rgb_tool" apply >/dev/null 2>&1 || true
        return 0
    fi
    # Not running -- start it unconditionally of the marker (self-healing).
    timeout 5 systemctl start "$rgb_service" 2>/dev/null || true
}

# Paint the current charge state onto the group LEDs, matching what the kernel
# trigger would paint on an event, so the "already charging" case shows amber
# immediately instead of the user's last color. Amber (charging) uses the same
# hue as armada-rgb's Battery effect (hsv 0.11,1,1 ~ 255,168,0); green = full.
# No-op (leaves the LEDs alone) when not charging -- on battery the sleeping
# glow is off, and a later plug-in is handled by the armed trigger's edge.
seed_current_charge() {
    local status cap r g b led order ch vals
    status=$(cat "$sysfs_root/class/power_supply/$psy/status" 2>/dev/null) || return 0
    case "$status" in
        Full)
            r=0; g=255; b=0 ;;
        Charging)
            cap=$(cat "$sysfs_root/class/power_supply/$psy/capacity" 2>/dev/null || echo 0)
            if [[ "$cap" == 100 ]]; then r=0; g=255; b=0; else r=255; g=168; b=0; fi ;;
        *)
            return 0 ;;
    esac
    for led in $indicator_leds_glob; do
        [[ -w "$led/multi_intensity" && -r "$led/multi_index" ]] || continue
        order=$(cat "$led/multi_index" 2>/dev/null) || continue
        vals=""
        for ch in $order; do
            case "$ch" in
                red) vals+="$r " ;;
                green) vals+="$g " ;;
                blue) vals+="$b " ;;
                *) vals+="0 " ;;
            esac
        done
        echo "${vals% }" >"$led/multi_intensity" 2>/dev/null || true
        # Match the kernel trigger's full brightness so there is no visible step
        # when it repaints on a later power_supply_changed().
        if [[ -w "$led/brightness" && -r "$led/max_brightness" ]]; then
            cat "$led/max_brightness" >"$led/brightness" 2>/dev/null || true
        fi
    done
}

case "${1:-}" in
    pre)
        indicator_enabled || exit 0
        # Order matters: take the daemon out of the way FIRST (so it can't
        # reclaim the trigger on its next tick), then keep the controllers
        # alive, arm the kernel trigger, and seed the current frame last so it
        # is the state that survives into sleep.
        stop_daemon
        set_keep_alive 1
        set_trigger "$trigger"
        seed_current_charge
        ;;
    post)
        # Unconditional and idempotent: safe even if `pre` never armed anything.
        set_trigger none
        set_keep_alive 0
        start_daemon
        ;;
esac
exit 0
