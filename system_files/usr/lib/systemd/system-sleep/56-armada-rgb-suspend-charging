#!/bin/bash
# Show charge status on the stick RGB LEDs while the device sleeps.
# Opt-in, default OFF (Armada Control -> RGB Lighting -> "Show charge status
# while sleeping").
#
# Coverage:
#   * Put to sleep while charging: `pre` seeds amber (charging) / green (full)
#     and the HTR3212 controllers hold that pattern in hardware through deep
#     sleep (keep_alive, no CPU).
#   * Plugged in, unplugged or filled up while asleep in deep with dark resume
#     (ARMADA_DARK_RESUME=1): the battery firmware's notification wakes the SoC,
#     dark-resume-lib sleeps again with the screen off and this hook's `pre`
#     seeds the new state. In charger mode armada-charger does the same rounds.
#   * Deep without dark resume: not reflected until the next wake.
#
# `pre`, when opted in:
#   1. Stop the armada-rgb daemon: its paint loop reclaims these LEDs from any
#      kernel trigger on every render tick, which would disarm the hand-off.
#   2. keep_alive=1 on the HTR3212 controllers: not powered down in suspend,
#      they keep driving their PWM pattern and their vdd_mcu_3v3 enable.
#   3. Arm the "<psy>-charging-orange-full-green" trigger on the group LEDs
#      (repaints on power_supply_changed() while the AP is up).
#   4. Seed the current state: arming a power-supply trigger paints nothing
#      until the next power_supply_changed() edge.
#
# `post`: on a user wake (power button) disarm the trigger, clear keep_alive
# and bring the daemon back; on any other wake keep the indicator up.
#
# Never blocks or delays suspend: every step is best-effort and a no-op without
# these LED nodes or the htr3212 driver.
set -uo pipefail

sysfs_root=${ARMADA_SYSFS_ROOT:-/sys}
rgb_tool=${ARMADA_RGB_TOOL:-/usr/bin/armada-rgb}
rgb_service=${ARMADA_RGB_SERVICE:-armada-rgb.service}
# Marker (tmpfs, cleared on reboot) recording that WE stopped the daemon, so
# `post` only restarts one we actually stopped.
daemon_marker=${ARMADA_RGB_DAEMON_MARKER:-/run/armada/rgb-charge-daemon-stopped}
# Owned by armada-control (its RGB_CHARGE_INDICATOR_CONFIG); read directly here
# since this hook runs standalone via systemd, not through the plugin socket.
indicator_config=${ARMADA_RGB_CHARGE_INDICATOR_CONFIG:-/etc/armada/rgb-charge-indicator.conf}
# Battery power-supply name -> the LED trigger power_supply_leds.c registers for
# it. qcom_battmgr exposes the pack as "battery" (confirmed on-device: G1).
psy=${ARMADA_RGB_CHARGE_PSY:-battery}
trigger="${psy}-charging-orange-full-green"
# Multicolor group nodes for the two HTR3212 stick controllers (rgb:l1..l4 /
# rgb:r1..r4), and the keep_alive knob on each bound htr3212 controller.
indicator_leds_glob=${ARMADA_RGB_INDICATOR_LEDS:-"$sysfs_root/class/leds/rgb:l? $sysfs_root/class/leds/rgb:r?"}
proc_interrupts=${ARMADA_PROC_INTERRUPTS:-/proc/interrupts}
# Written by dark-resume-lib (suspend-dispatch) before each dark-resume round.
pwrkey0_file=${ARMADA_DARK_RESUME_PWRKEY0:-/run/armada/dark-resume.pwrkey0}
keep_alive_glob=${ARMADA_RGB_KEEPALIVE:-"$sysfs_root/bus/i2c/drivers/htr3212/*/keep_alive"}

[[ "${2:-}" == suspend ]] || exit 0

# Opt-in, default OFF (matches armada-control's own fallback: an absent,
# unreadable or malformed file means disabled).
indicator_enabled() {
    local key value
    [[ -r "$indicator_config" ]] || return 1
    while IFS='=' read -r key value; do
        if [[ "$key" == "enabled" ]]; then
            [[ "$value" == "1" ]] && return 0 || return 1
        fi
    done <"$indicator_config"
    return 1
}

# Percent of max_brightness for the charge colours (Armada Control slider, same
# file as `enabled`). Missing or out of 1..100 means full brightness.
indicator_brightness_pct() {
    local key value
    [[ -r "$indicator_config" ]] || { echo 100; return; }
    while IFS='=' read -r key value; do
        if [[ "$key" == brightness && "$value" =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 100 )); then
            echo "$value"; return
        fi
    done <"$indicator_config"
    echo 100
}

set_keep_alive() { # $1 = 0|1
    local f
    for f in $keep_alive_glob; do
        [[ -w "$f" ]] || continue
        echo "$1" >"$f" 2>/dev/null || true
    done
}

set_trigger() { # $1 = trigger name, or "none"
    local led
    for led in $indicator_leds_glob; do
        [[ -w "$led/trigger" ]] || continue
        echo "$1" >"$led/trigger" 2>/dev/null || true
    done
}

# True (0) while a charger is attached -- charging or already full. When this is
# false the charge indicator has nothing to show and `post` restores normally.
is_charging() {
    local status
    status=$(cat "$sysfs_root/class/power_supply/$psy/status" 2>/dev/null) || return 1
    [[ "$status" == Charging || "$status" == Full ]]
}

# True (0) if THIS resume was a user wake (power button), read straight from
# pm_wakeup_irq (like 40-armada-wake-ledger) so hook order does not matter.
# Anything that is NOT the power key (firmware notification, rtc, unknown)
# counts as non-user so the indicator is kept up. The pmic_pwrkey counter delta
# (see below) catches a button press reported as "none".
was_user_wake() {
    local irq name pk0 pk1
    irq=$(cat "$sysfs_root/power/pm_wakeup_irq" 2>/dev/null)
    name=$(awk -v i="${irq}:" '$1 == i {print $NF}' "$proc_interrupts" 2>/dev/null)
    case "$name" in
        *pwrkey*) return 0 ;;
    esac
    # A power-button wake can also be reported as "none". dark-resume-lib (and
    # armada-charger) record the pmic_pwrkey counter before each round; a delta
    # means the button was pressed.
    if [[ -r "$pwrkey0_file" ]]; then
        pk0=$(<"$pwrkey0_file")
        pk1=$(awk '$NF == "pmic_pwrkey" { for (i = 2; i < NF; i++) if ($i ~ /^[0-9]+$/) s += $i } END { print s + 0 }' \
            "$proc_interrupts" 2>/dev/null)
        [[ "$pk0" =~ ^[0-9]+$ ]] && (( pk1 > pk0 )) && return 0
    fi
    return 1
}

# Stop the daemon so it stops reclaiming the trigger; record that we did.
stop_daemon() {
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl is-active --quiet "$rgb_service" 2>/dev/null || return 0
    mkdir -p "$(dirname "$daemon_marker")" 2>/dev/null || true
    if timeout 5 systemctl stop "$rgb_service" 2>/dev/null; then
        : >"$daemon_marker" 2>/dev/null || true
    fi
}

# Bring the daemon back after resume. Idempotent and independent of the marker:
# if `pre` stopped the daemon but could not write the marker, the daemon must
# still come back, or every animated effect stays dead until reboot. Start vs
# nudge is decided by whether the service is running, not by the marker.
start_daemon() {
    rm -f "$daemon_marker" 2>/dev/null || true
    command -v systemctl >/dev/null 2>&1 || return 0
    if systemctl is-active --quiet "$rgb_service" 2>/dev/null; then
        # Still running (we never stopped it -- e.g. indicator off): just nudge
        # a repaint of the user's own lighting, don't restart.
        [[ -x "$rgb_tool" ]] && timeout 5 "$rgb_tool" apply >/dev/null 2>&1 || true
        return 0
    fi
    # Not running -- start it unconditionally of the marker (self-healing).
    timeout 5 systemctl start "$rgb_service" 2>/dev/null || true
}

# Paint the current charge state onto the group LEDs, matching what the kernel
# trigger would paint on an event, so the "already charging" case shows amber
# immediately instead of the user's last color. Amber (charging) uses the same
# hue as armada-rgb's Battery effect (hsv 0.11,1,1 ~ 255,168,0); green = full.
# On battery it blanks the LEDs: `pre` keeps the controllers alive (keep_alive)
# so a plug-in mid-sleep can repaint them, and the user's last frame would stay
# lit all night on battery.
seed_current_charge() {
    local status cap r g b led order ch vals max level pct
    pct=$(indicator_brightness_pct)
    status=$(cat "$sysfs_root/class/power_supply/$psy/status" 2>/dev/null) || return 0
    case "$status" in
        Full)
            r=0; g=255; b=0 ;;
        Charging)
            cap=$(cat "$sysfs_root/class/power_supply/$psy/capacity" 2>/dev/null || echo 0)
            if [[ "$cap" == 100 ]]; then r=0; g=255; b=0; else r=255; g=168; b=0; fi ;;
        *)
            r=0; g=0; b=0 ;;
    esac
    for led in $indicator_leds_glob; do
        [[ -w "$led/multi_intensity" && -r "$led/multi_index" ]] || continue
        order=$(cat "$led/multi_index" 2>/dev/null) || continue
        vals=""
        for ch in $order; do
            case "$ch" in
                red) vals+="$r " ;;
                green) vals+="$g " ;;
                blue) vals+="$b " ;;
                *) vals+="0 " ;;
            esac
        done
        echo "${vals% }" >"$led/multi_intensity" 2>/dev/null || true
        # The configured share of max_brightness. A later kernel-trigger repaint
        # (only while the AP is up) goes back to full brightness.
        if [[ "$r$g$b" == 000 ]]; then
            [[ -w "$led/brightness" ]] && echo 0 >"$led/brightness" 2>/dev/null || true
        elif [[ -w "$led/brightness" && -r "$led/max_brightness" ]]; then
            max=$(cat "$led/max_brightness" 2>/dev/null) && [[ "$max" =~ ^[0-9]+$ ]] || continue
            level=$(( (max * pct + 50) / 100 )); (( level < 1 )) && level=1
            echo "$level" >"$led/brightness" 2>/dev/null || true
        fi
    done
}

case "${1:-}" in
    pre)
        indicator_enabled || exit 0
        # Order matters: take the daemon out of the way FIRST (so it can't
        # reclaim the trigger on its next tick), then keep the controllers
        # alive, arm the kernel trigger, and seed the current frame last so it
        # is the state that survives into sleep.
        stop_daemon
        set_keep_alive 1
        set_trigger "$trigger"
        seed_current_charge
        ;;
    post)
        # If the indicator is on and this was NOT a user wake (power button), the
        # device woke on its own (firmware notification, rtc, a dark-resume or
        # charger-mode round that sleeps again right after) with the screen off.
        # Handing the LEDs back to the daemon would repaint the user's effect
        # (screen_sync: dark screen, dark LEDs). So keep the indicator up: re-seed the
        # CURRENT state (amber/green, or blank on battery -- also when the
        # charger was just unplugged, so no flash of the user's colour) and leave
        # the trigger armed + daemon stopped (the marker persists). The full
        # restore below runs on the REAL user wake (power button) or when
        # dark-resume-lib forces it for the final non-user wake
        # (ARMADA_RGB_FORCE_RESTORE=1).
        # Discharging only keeps the indicator inside a dark-resume round (the
        # pwrkey0 file exists only while dark-resume-lib is looping, and the lib
        # restores on its final non-user wake); outside it, a non-user wake on
        # battery restores as before.
        if [[ "${ARMADA_RGB_FORCE_RESTORE:-0}" != 1 ]] && indicator_enabled && ! was_user_wake &&
            { is_charging || [[ -e "$pwrkey0_file" ]]; }; then
            set_keep_alive 1
            set_trigger "$trigger"
            seed_current_charge
            exit 0
        fi
        # Unconditional and idempotent: safe even if `pre` never armed anything.
        set_trigger none
        set_keep_alive 0
        start_daemon
        ;;
esac
exit 0
