[Unit]
Description=Rebuild the ABL boot.img for the next-boot deployment before reboot
ConditionPathExists=/run/ostree-booted
DefaultDependencies=no
RequiresMountsFor=/sysroot /boot /boot/efi
# Reverse stop order: ordered before finalize so our ExecStop runs after it,
# against the finalized next-boot deployment.
After=local-fs.target systemd-journal-flush.service
Before=ostree-finalize-staged.service final.target
Conflicts=final.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Must outlast the lock wait plus a slow-card regen, or systemd kills it mid-write.
TimeoutStopSec=180
# Completes a regen that died in the previous shutdown. '-' is load-bearing: a
# failed start would fail the unit and skip ExecStop.
ExecStart=-/usr/bin/ionice -c 2 -n 7 /usr/libexec/armada/armada-bootimg-update --snapshot-prev
# Charger-mode image (boot_a/boot_b) at boot too: the shutdown that follows an
# update runs the previous image's units, which may not have this step.
ExecStart=-/usr/bin/ionice -c 2 -n 7 /usr/libexec/armada/armada-chargerimg-update
# Keep manual rollback and other non-staged BLS changes in sync. Staged-update
# failure handling belongs to the OSTree finalization hook.
ExecStop=/usr/libexec/armada/armada-bootimg-update
# ABL writes are allowed only after /KERNEL sync succeeds.
ExecStop=-/usr/libexec/armada/armada-abl-finalize
ExecStop=-/usr/libexec/armada/armada-chargerimg-update

[Install]
WantedBy=multi-user.target
